{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://victoria-citylab.local/schemas/architecture_style.schema.json",
  "title": "Victoria CityLab architectural style contract",
  "description": "Un style décrit l'apparence partagée par toutes les familles de bâtiments. Le catalogue décrit le programme (fonction, système de mur, marqueurs, graine, emprise de base) ; le style décrit le regard. Changer un nombre ici doit restyler tout le kit, et un second style doit être un second fichier, pas une seconde branche de code.",
  "type": "object",
  "required": ["schema", "id", "footprint", "levels", "foundation", "wall", "roof", "opening", "trim", "budget", "lod", "silhouette_gate", "review", "palettes"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "label": { "type": "string", "minLength": 1 },
    "notes": { "type": "array", "items": { "type": "string" } },

    "footprint": {
      "description": "L'emprise du catalogue est le centre, pas la valeur finale. Le jitter s'applique autour d'elle et la forme est tirée de la graine.",
      "type": "object",
      "required": ["forms", "dimension_jitter", "min_side_m"],
      "additionalProperties": false,
      "properties": {
        "forms": { "$ref": "#/$defs/weighted_choices" },
        "dimension_jitter": { "$ref": "#/$defs/range" },
        "min_side_m": { "type": "number", "exclusiveMinimum": 0 },
        "l_shape": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "wing_width_ratio": { "$ref": "#/$defs/range" },
            "wing_depth_ratio": { "$ref": "#/$defs/range" }
          }
        },
        "lean_to": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "depth_ratio": { "$ref": "#/$defs/range" },
            "height_ratio": { "$ref": "#/$defs/range" },
            "pitch_deg": { "$ref": "#/$defs/range" }
          }
        }
      }
    },

    "levels": {
      "type": "object",
      "required": ["forms"],
      "additionalProperties": false,
      "properties": { "forms": { "$ref": "#/$defs/weighted_choices" } }
    },

    "foundation": {
      "type": "object",
      "required": ["height_m", "projection_m", "bevel_m"],
      "additionalProperties": false,
      "properties": {
        "height_m": { "$ref": "#/$defs/range" },
        "projection_m": { "type": "number", "minimum": 0 },
        "bevel_m": { "type": "number", "minimum": 0 }
      }
    },

    "wall": {
      "type": "object",
      "required": ["thickness_m", "height_jitter", "corner_post_m", "bevel_m"],
      "additionalProperties": false,
      "properties": {
        "thickness_m": { "type": "number", "exclusiveMinimum": 0 },
        "height_jitter": { "$ref": "#/$defs/range" },
        "corner_post_m": { "type": "number", "exclusiveMinimum": 0 },
        "bevel_m": { "type": "number", "minimum": 0 }
      }
    },

    "roof": {
      "description": "La pente est autoritaire : la hauteur de faîtage est dérivée de pitch_deg, du demi-plan et du débord. Le quatrième nombre de dimensions dans le catalogue devient une valeur dérivée.",
      "type": "object",
      "required": ["forms", "pitch_deg", "overhang_m", "ridge_axis", "thickness_m", "eave_strip"],
      "additionalProperties": false,
      "properties": {
        "forms": { "$ref": "#/$defs/weighted_choices" },
        "pitch_deg": { "$ref": "#/$defs/angle_range" },
        "overhang_m": { "$ref": "#/$defs/range" },
        "ridge_axis": { "$ref": "#/$defs/weighted_choices" },
        "thickness_m": { "type": "number", "exclusiveMinimum": 0 },
        "eave_strip": {
          "description": "La silhouette dentelée du toit est portée par cette seule bande, plus par des tuiles individuelles.",
          "type": "object",
          "required": ["depth_m", "mode"],
          "additionalProperties": false,
          "properties": {
            "depth_m": { "type": "number", "exclusiveMinimum": 0 },
            "mode": { "enum": ["alpha_clip", "toothed_geometry"] },
            "teeth_per_m": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },

    "opening": {
      "description": "Une ouverture est un trou percé au boolean avec une embrasure, jamais un panneau posé devant le mur.",
      "type": "object",
      "required": ["reveal_depth_m", "min_pier_m", "door", "window"],
      "additionalProperties": false,
      "properties": {
        "reveal_depth_m": { "$ref": "#/$defs/range" },
        "min_pier_m": { "type": "number", "exclusiveMinimum": 0 },
        "door": {
          "type": "object",
          "required": ["width_m", "wide_width_m", "height_m", "lintel_height_m"],
          "additionalProperties": false,
          "properties": {
            "width_m": { "$ref": "#/$defs/range" },
            "wide_width_m": { "$ref": "#/$defs/range" },
            "height_m": { "$ref": "#/$defs/range" },
            "lintel_height_m": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "window": {
          "type": "object",
          "required": ["width_m", "height_m", "sill_height_m", "shutters_probability"],
          "additionalProperties": false,
          "properties": {
            "width_m": { "$ref": "#/$defs/range" },
            "height_m": { "$ref": "#/$defs/range" },
            "sill_height_m": { "$ref": "#/$defs/range" },
            "shutters_probability": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },

    "trim": {
      "description": "Toute la matière vient de l'atlas. Aucun matériau procédural ne subsiste dans le chemin d'export : le bruit Blender ne s'exporte ni en FBX ni en glTF.",
      "type": "object",
      "required": ["atlas", "published_root", "maps", "rects", "wall_system_map", "roof_system_map", "world_uv_scale_m"],
      "additionalProperties": false,
      "properties": {
        "atlas": { "type": "string", "pattern": "^citylab_trim_v[0-9]+$" },
        "published_root": { "type": "string", "minLength": 1 },
        "maps": {
          "type": "array",
          "minItems": 5,
          "items": { "enum": ["BaseColor", "Normal", "AO", "Roughness", "Metallic", "VariationMask"] }
        },
        "rects": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["u", "v"],
            "additionalProperties": false,
            "properties": {
              "u": { "$ref": "#/$defs/unit_range" },
              "v": { "$ref": "#/$defs/unit_range" }
            }
          }
        },
        "wall_system_map": {
          "description": "Chaque système de mur du catalogue dit quelle bande habille son soubassement et son corps.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["base", "body"],
            "additionalProperties": false,
            "properties": {
              "base": { "type": "string", "minLength": 1 },
              "body": { "type": "string", "minLength": 1 },
              "base_height_m": { "type": "number", "minimum": 0 },
              "requires_atlas": {
                "description": "Ce système emprunte une bande voisine faute d'avoir la sienne. Consigne la dette en donnée plutôt qu'en prose : l'atlas nommé doit exister avant que le système soit considéré fini.",
                "type": "string",
                "pattern": "^citylab_trim_v[0-9]+$"
              }
            }
          }
        },
        "roof_system_map": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "world_uv_scale_m": { "type": "number", "exclusiveMinimum": 0 }
      }
    },

    "budget": {
      "type": "object",
      "required": ["classes", "function_class", "max_bevel_segments", "max_cylinder_vertices"],
      "additionalProperties": false,
      "properties": {
        "classes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["lod"],
            "additionalProperties": false,
            "properties": {
              "lod": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": { "type": "integer", "exclusiveMinimum": 0 }
              }
            }
          }
        },
        "function_class": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "max_bevel_segments": { "type": "integer", "minimum": 1 },
        "max_cylinder_vertices": { "type": "integer", "minimum": 3 }
      }
    },

    "lod": {
      "description": "Le LOD procède par suppression d'éléments. La décimation en collapse détruit un assemblage de pièces séparées : les biseaux tombent en premier et la silhouette ondule.",
      "type": "object",
      "required": ["policy", "lod1", "lod2"],
      "additionalProperties": false,
      "properties": {
        "policy": { "const": "element_removal" },
        "lod1": {
          "type": "object",
          "required": ["drop_categories", "decimate_curved_min_ratio"],
          "additionalProperties": false,
          "properties": {
            "drop_categories": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "decimate_curved_min_ratio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          }
        },
        "lod2": {
          "type": "object",
          "required": ["keep_categories"],
          "additionalProperties": false,
          "properties": {
            "keep_categories": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        }
      }
    },

    "silhouette_gate": {
      "description": "En vue RTS l'œil lit la silhouette avant la matière. Deux variantes indistinctes en noir sont la même variante.",
      "type": "object",
      "required": ["render_px", "camera", "max_iou_same_family", "max_iou_cross_function"],
      "additionalProperties": false,
      "properties": {
        "render_px": { "type": "integer", "minimum": 32 },
        "camera": { "const": "rts" },
        "max_iou_same_family": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "max_iou_cross_function": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },

    "review": {
      "description": "contact_sheet_px est la taille RTS réelle. Une revue conduite sur les rendus héroïques valide des bâtiments qu'on ne verra jamais ainsi.",
      "type": "object",
      "required": ["contact_sheet_px", "hero_px"],
      "additionalProperties": false,
      "properties": {
        "contact_sheet_px": { "type": "integer", "minimum": 32 },
        "hero_px": { "type": "integer", "minimum": 128 }
      }
    },

    "palettes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "wood", "wood_highlight", "roof", "roof_accent"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+$" },
          "label": { "type": "string" },
          "wood": { "$ref": "#/$defs/hex_color" },
          "wood_highlight": { "$ref": "#/$defs/hex_color" },
          "roof": { "$ref": "#/$defs/hex_color" },
          "roof_accent": { "$ref": "#/$defs/hex_color" }
        }
      }
    }
  },

  "$defs": {
    "range": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number" }
    },
    "unit_range": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "angle_range": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 90 }
    },
    "hex_color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "weighted_choices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "weight"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  }
}
