* text=auto eol=lf

# Les assets Unity, quand ils arriveront (lot 101).
*.fbx filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.unitypackage filter=lfs diff=lfs merge=lfs -text

# Les assets sérialisés par Unity ne sont pas du source écrit à la main : son
# writer YAML émet « cle: » pour une valeur vide, et `git diff --check` en
# tirait des centaines de faux positifs qui noyaient les vrais. On ne corrige
# pas cette sortie — un .meta ne s'édite jamais à la main — on dit à git de ne
# pas y appliquer le lint d'espaces, pour que le contrôle redevienne lisible
# sur le code.
*.meta -whitespace
*.mat -whitespace
*.prefab -whitespace
*.unity -whitespace
*.asset -whitespace

# La carte figée : un seul fichier, jamais fusionné à la main.
data/world-1400.json -merge
